# The default is the offline mock. Keep it unless you want to call the Gemini model in the app.
# LLM_PROVIDER=mock | gemini
LLM_PROVIDER=mock

# Gemini key(s). Use GEMINI_API_KEY for one key, or GEMINI_API_KEYS="key1,key2" to rotate
# to the next key when one hits its quota. Never commit real keys.
GEMINI_API_KEY=
# GEMINI_API_KEYS=

# Model fallback lists, tried in order (an overloaded or missing model is skipped)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash
# GEMINI_JUDGE_MODELS=gemini-3.8-flash,gemini-3.6-flash

# Judge selection: auto (Copilot CLI, then Gemini) | copilot | gemini
JUDGE_PROVIDER=auto
COPILOT_JUDGE_MODEL=fusion
# AI test assistance selection: auto (Copilot CLI, then Gemini) | copilot | gemini
TESTING_AI_PROVIDER=auto
COPILOT_TESTING_MODEL=fusion
# GEMINI_TESTING_MODELS=gemini-3.8-flash,gemini-3.6-flash
# Fusion auto tier: hydrafusion = Fusion High (best quality). Falls back to the CLI default if unavailable.
COPILOT_FUSION_TIER=hydrafusion

# Chaos Lab autoheal selection: auto (Copilot CLI, then Gemini) | copilot | gemini
HEAL_PROVIDER=auto
COPILOT_HEAL_MODEL=fusion
# GEMINI_HEAL_MODELS=gemini-3.8-flash,gemini-3.6-flash
# PORT=3000
