# The default is the offline mock. Keep it unless you want to call the Gemini model in the app.
# LLM_PROVIDER=mock | gemini
LLM_PROVIDER=mock

# Used only when Copilot CLI is unavailable. Leave empty if Copilot is working.
GEMINI_API_KEY=

# Optional model overrides
COPILOT_JUDGE_MODEL=fusion
GEMINI_JUDGE_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# PORT=3000
