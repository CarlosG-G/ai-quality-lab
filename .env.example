# The default is the offline mock. Set these only to run against a real model.
# LLM_PROVIDER=mock | github-models
LLM_PROVIDER=mock

# Needed for github-models. A fine-grained token with "Models: read" is enough.
# In GitHub Actions the built-in GITHUB_TOKEN works with `permissions: models: read`.
GITHUB_TOKEN=

# Optional overrides
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
# PORT=3000
