{
  "name": "ai-quality-lab",
  "version": "0.1.0",
  "private": true,
  "description": "AI-augmented quality engineering: test an LLM app end to end, and use AI to test better.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "eval": "node --env-file-if-exists=.env evals/run.ts",
    "eval:judge": "npm run eval && node --env-file-if-exists=.env evals/judge-run.ts",
    "dashboard:build": "node --env-file-if-exists=.env scripts/build-dashboard.ts",
    "report": "playwright show-report"
  },
  "license": "MIT",
  "author": "Carlos Gonzalez",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlosG-G/ai-quality-lab.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
